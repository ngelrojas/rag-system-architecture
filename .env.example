# Copy to .env and fill in. Only needed to call real services —
# the tests use fakes and in-process Qdrant and never need them.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
MIN_RELEVANCE_THRESHOLD=0.5
CHUNK_SIZE=500
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# 5.4 — durable human-in-the-loop pauses (leave empty for in-memory)
CHECKPOINT_DATABASE_URL=
# 5.5 — natural-language queries over a relational database
STRUCTURED_DATABASE_URL=sqlite:///:memory:
NLQ_SCHEMA=

# 6.4 — swappable inference: cloud | local (Ollama, vLLM, llama.cpp server)
INFERENCE_MODE=cloud
LOCAL_INFERENCE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b
# 6.1 — share of answers sent to the LLM judge
JUDGE_SAMPLE_RATE=0.05
